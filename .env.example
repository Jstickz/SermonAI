
# Copy to .env and fill in. Never commit .env (see .gitignore).
# In shipped builds these are provisioned through SermonAI licensing and stored
# in the OS keychain — customers never handle them (PRD §17).

# Speech-to-text, online mode (PRD §15.1)
DEEPGRAM_API_KEY=

# Licensed scripture text (PRD §15.2)
API_BIBLE_KEY=

# Paraphrase detection + summary generation (PRD §15.3)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6


# Pack CDN base URL that packs-manifest.json is fetched from (PRD §15.5)
PACK_CDN_BASE_URL=https://packs.sermonai.app

# Tauri updater public key (the private key lives in CI secrets only)
TAURI_SIGNING_PUBLIC_KEY=
